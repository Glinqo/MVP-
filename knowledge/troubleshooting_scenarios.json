    {
      "id": "SCN_PLC_LED_ON_MONITOR_OFF",
      "title": "PLC 输入灯亮但在线监控不变",
      "roleplay_frame": "你要判断信号已经到输入模块，但程序或监控地址为什么没有变化。",
      "initial_symptom": "传感器动作灯亮，PLC 输入灯亮，但在线监控的目标地址不变。",
      "safety_notice": "安全提醒：PLC 在线监控前确认设备状态安全，不让执行机构误动作；不确定时请教师确认。",
      "ability_ids": [
        "plc_io_address_mapping",
        "program_variable_lookup",
        "plc_input_monitoring"
      ],
      "steps": [
        {
          "id": "S1",
          "prompt": "PLC 输入灯已亮但监控不变，最优先核对什么？",
          "ability_ids": [
            "plc_io_address_mapping",
            "program_variable_lookup"
          ],
          "options": [
            {
              "id": "A",
              "text": "核对物理输入点、I/O 地址表和程序变量是否一致",
              "is_correct": true,
              "feedback": "正确。输入灯亮说明模块侧有信号，下一步看地址映射和变量引用。",
              "observation": "你发现现场接到 I0.2，但程序监控的是 I0.3。"
            },
            {
              "id": "B",
              "text": "优先更换传感器",
              "is_correct": false,
              "feedback": "顺序不对。输入灯已经亮，传感器侧暂时不是优先怀疑点。",
              "observation": "传感器动作稳定，问题更像地址或程序变量。"
            },
            {
              "id": "C",
              "text": "直接短接输出信号验证",
              "is_correct": false,
              "feedback": "不允许。不能指导短接或绕过安全方式验证。",
              "observation": "师傅要求按地址表和程序监控方式排查。"
            }
          ],
          "next_step_id": null
        }
      ],
      "source": "project_curated"
    },
